# Copy to .env and fill in. Read by app/config.py at startup; a variable
# already exported in the shell overrides whatever is in the file.
#
# All of these are optional. Without an LLM key the app parses, renders and
# exports normally — it disables claim verdicts and agentic editing and says
# so, rather than faking output.

# LLM — one of these enables claim checks + the editing agent.
OPENAI_API_KEY=
# GEMINI_API_KEY=
# PIA_LLM_PROVIDER=auto          # openai | gemini | auto (prefers openai)
# PIA_OPENAI_MODEL=gpt-4o-mini

# Semantic Scholar. Free, and worth having: the unauthenticated pool is
# rate-limited hard. OpenAlex needs no key at all.
# S2_API_KEY=
# OPENALEX_MAILTO=you@example.com

# Seconds the parse view spends narrating its stages. 0 = no pacing.
# PIA_PARSE_MIN_SECONDS=16
